{
  "name": "dsh-cost-usage-display",
  "version": "2.0.0",
  "description": "DSH 用量显示（Usage Display）— DeepSeek Harness 官方 bundle 插件包格式。在 DSH Web GUI 右侧新增第四列（用量 / 文件），含会话用量、费用估算、文件树与官方余额。安装：dsh plugin --profile web add github:zcxyy123-dev/dsh-cost",
  "license": "MIT",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./client/bundle.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "dsh-plugin",
    "docs",
    "skill",
    "userscript",
    "console",
    "extension",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:bundle": "node build-bundle.js",
    "verify:bundle": "node verify-bundle.js",
    "test:bundle": "node test-bundle-host.js"
  }
}
